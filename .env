# WebSocket Server — Development Environment
PORT=3001
NODE_ENV=development

# Laravel backend API URL
LARAVEL_API_URL=http://localhost:8000/api/v1

# CORS: allow local Vite dev server
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Redis (local development — no password needed)
REDIS_URL=redis://127.0.0.1:6379

# Rate limiting
MAX_CONNECTIONS_PER_IP=20
MESSAGE_RATE_LIMIT=30
MESSAGE_RATE_WINDOW=60

# Presence / heartbeat
PRESENCE_TIMEOUT=90000
HEARTBEAT_INTERVAL=30000
MATCH_RETRY_INTERVAL=2000

# Socket.IO tuning
PING_TIMEOUT=10000
PING_INTERVAL=25000
MAX_HTTP_BUFFER_SIZE=1048576
