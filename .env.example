# WebSocket Server Configuration
PORT=3001
NODE_ENV=production

# Laravel Backend API
LARAVEL_API_URL=http://localhost:8000/api/v1

# Redis (any version >= 2.6.12). Use rediss:// for TLS.
REDIS_URL=redis://127.0.0.1:6379

# CORS: comma-separated exact origins allowed to connect
CORS_ORIGINS=http://localhost:5173

# Set to true behind a proxy/load balancer (e.g. Render) so limits use the client IP
TRUST_PROXY=false

# Rate limiting. Campus users often share one public IP, so keep per-IP limits generous.
MAX_CONNECTIONS_PER_IP=200
MAX_AUTH_FAILURES=30
MESSAGE_RATE_LIMIT=10
# Window in SECONDS
MESSAGE_RATE_WINDOW=60

# Socket.IO tuning (milliseconds)
PING_TIMEOUT=20000
PING_INTERVAL=25000
MAX_HTTP_BUFFER_SIZE=1000000

# Matching / presence (milliseconds)
MATCH_RETRY_INTERVAL=2000
HEARTBEAT_INTERVAL=30000
# How long a dropped connection may reconnect before its chat is ended
DISCONNECT_GRACE_MS=15000
